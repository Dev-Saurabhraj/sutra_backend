# --- runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated origins allowed by CORS ("*" in development only)
CORS_ORIGINS=*

# --- database (docker compose maps Postgres to localhost:5433) ---
DATABASE_URL=postgresql://sutra:sutra@localhost:5433/sutra?schema=public

# --- auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Development only: this OTP always works. Ignored unless NODE_ENV=development.
DEV_OTP=123456

# --- AI (optional) ---
# Without a key Sutra uses its rule-based fallbacks (voice parser, story template).
ANTHROPIC_API_KEY=
# Set to "off" to force offline mode even when a key is present.
SUTRA_AI=
